# GEMINI_API_KEY: Required for Gemini AI API calls unless OPENAI_API_KEY is set.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional second generation provider if every Gemini model fails.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# APP_URL: Public origin of this API (used for Stripe redirects).
APP_URL="http://localhost:3000"

# Comma-separated browser origins allowed to call this API (Pages + local).
# CORS_ORIGINS="https://dropfable.com,https://www.dropfable.com,http://localhost:3000"

# Per-IP Gemini route cap. Default 20/min.
# RATE_LIMIT_PER_MIN="20"

# Autonomous hourly factory. Default OFF. Never enable git push on the Pages repo.
# AUTONOMOUS_ENABLED="true"
# AUTONOMOUS_GIT_PUSH="true"

# ── SaaS billing & API-key metering (OPTIONAL; OFF by default) ────────────
# BILLING_ENABLED="true"
# FREE_QUOTA="5"
# STARTER_QUOTA="100"
# PRO_QUOTA="1000"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_PRO="price_..."
# STARTER_PRICE_LABEL="$9/mo"
# PRO_PRICE_LABEL="$29/mo"
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
