# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── SaaS billing & API-key metering (all OPTIONAL; OFF by default) ────────────
# The whole billing layer is inert unless BILLING_ENABLED=true. With it off, the
# app behaves exactly as the free/self-hosted tool (no keys, no quota, no Pricing
# tab). Turn it on to charge for access: callers sign up for an API key, each
# generation consumes one unit of their monthly quota, and paid plans are sold
# through Stripe Checkout.
# BILLING_ENABLED="true"

# Monthly generation quotas per plan (defaults shown).
# FREE_QUOTA="5"
# STARTER_QUOTA="100"
# PRO_QUOTA="1000"

# Stripe — required only to SELL paid plans (signup + free tier work without it).
# Create recurring Prices in the Stripe dashboard and paste their IDs here.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."          # from the webhook endpoint you add
# STRIPE_PRICE_STARTER="price_..."           # monthly price IDs
# STRIPE_PRICE_PRO="price_..."
# STARTER_PRICE_LABEL="$9/mo"                # display only
# PRO_PRICE_LABEL="$29/mo"                   # display only

# Annual plans (optional). Create yearly recurring Prices and paste their IDs; the
# Pricing UI then shows a Monthly/Annual toggle.
# STRIPE_PRICE_STARTER_ANNUAL="price_..."
# STRIPE_PRICE_PRO_ANNUAL="price_..."
# STARTER_ANNUAL_PRICE_LABEL="$90/yr"        # display only
# PRO_ANNUAL_PRICE_LABEL="$290/yr"           # display only

# Usage-based overage (optional). Paid plans allow generations beyond their quota,
# billed per unit. Set *_OVERAGE="false" to hard-cap a plan instead. To actually
# CHARGE for overage, create a Stripe Billing Meter and set its event name here;
# each overage unit emits one meter event for the customer (unset = counted only).
# STRIPE_OVERAGE_METER_EVENT="dropkit_generation"
# STARTER_OVERAGE="true"                     # default true for paid plans
# PRO_OVERAGE="true"
# STARTER_OVERAGE_LABEL="$0.10/ea"           # display only
# PRO_OVERAGE_LABEL="$0.05/ea"               # display only

# Persistent account store. REQUIRED on serverless (Vercel) — without it accounts
# live in per-instance memory and won't survive between requests. Use Upstash
# Redis (REST API; no SDK needed). Locally you can omit these (in-memory store).
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
